rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Student profile pictures: readable by any authenticated user,
    // writable only by the owner of the profile (uid in path must match).
    match /student-profiles/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Website logo images: readable by everyone (displayed on every page).
    // Uploads are handled server-side by the authorized admin flow
    // (/api/logo), which stores files under public/uploads/website/logo.
    // The legacy storage paths below are write-disabled entirely — no
    // client can upload, replace, or delete logo files directly.
    match /website-logos/{fileName} {
      allow read: if true;
      allow write: if false;
    }
    match /website/logo/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Hero banner images: readable by everyone (displayed on the homepage),
    // writable so new banners can be uploaded directly from the website.
    // Only the current banners' download URLs are stored in Firestore.
    match /website-banners/{fileName} {
      allow read: if true;
      allow write: if true;
    }
  }
}