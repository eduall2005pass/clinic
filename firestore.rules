rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // A student can only read/write their own profile document.
    match /students/{uid} {
      allow create, read, update, delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Student ID index used to guarantee unique IDs.
    match /studentIds/{studentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Course catalog registry. Must stay in sync with src/lib/courses.ts.
    // Clients may only create canonical registry documents; they cannot
    // overwrite or tamper with existing ones.
    function canonicalKind(courseId) {
      return courseId == "botany"
          || courseId == "zoology"
          || courseId == "biology-revision"
          || courseId == "medical-admission"
          || courseId == "botany-27"
          || courseId == "zoology-27"
          || courseId == "biology-revision-27"
          || courseId == "medical-admission-27"
          || courseId == "botany-26"
          || courseId == "zoology-26"
          || courseId == "biology-revision-26"
          || courseId == "medical-admission-26" ? "paid" : null;
    }
    match /courses/{courseId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.kind == canonicalKind(courseId)
        && request.resource.data.courseId == courseId;
      allow update, delete: if false;
    }

    // Enrollment records. Document ID format: {uid}_{courseId}.
    // A student can only create or manage their own enrollment, and only
    // through the allowed transitions below. Paid enrollments can never be
    // created as active — they require payment/approval.
    function isOwnEnrollment(enrollmentId) {
      return isSignedIn()
        && enrollmentId.split('_')[0] == request.auth.uid;
    }
    function validCreate(enrollmentId) {
      return isOwnEnrollment(enrollmentId)
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.courseId == enrollmentId.split('_').slice(1).join('_')
        && request.resource.data.courseKind == canonicalKind(request.resource.data.courseId)
        && ((request.resource.data.courseKind == "free"
              && request.resource.data.enrollmentStatus == "active")
            || (request.resource.data.courseKind == "paid"
              && request.resource.data.enrollmentStatus == "pending"));
    }
    function validTransition(from, to, kind) {
      return (from == "active" && to == "cancelled")
          || (from == "pending" && to == "cancelled")
          || (from == "cancelled" && to == "pending")
          || (from == "cancelled" && to == "active" && kind == "free");
    }
    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn()
        && resource.data.studentUid == request.auth.uid
        && enrollmentId.split('_')[0] == request.auth.uid;
      allow create: if validCreate(enrollmentId);
      allow update: if isOwnEnrollment(enrollmentId)
        && resource.data.studentUid == request.auth.uid
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.courseId == resource.data.courseId
        && request.resource.data.courseKind == resource.data.courseKind
        && validTransition(
            resource.data.enrollmentStatus,
            request.resource.data.enrollmentStatus,
            request.resource.data.courseKind);
      allow delete: if false;
    }

    // Enrolled-course content: classes, materials, and course exams may
    // only be read by students with an ACTIVE enrollment for that course.
    // Enrollment document ID format: {uid}_{courseId}.
    function enrollmentDocId(uid, courseId) {
      return uid + "_" + courseId;
    }
    function isEnrolled(courseId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/enrollments/$(enrollmentDocId(request.auth.uid, courseId))).data.enrollmentStatus == "active";
    }
    match /courses/{courseId} {
      match /classes/{classId} { allow read: if isEnrolled(courseId); allow write: if false; }
      match /materials/{materialId} { allow read: if isEnrolled(courseId); allow write: if false; }
      match /exams/{examId} { allow read: if isEnrolled(courseId); allow write: if false; }
    }

    // Q&A content requires an ACTIVE PAID course enrollment.
    function isEnrolledPaid(courseId) {
      return isEnrolled(courseId)
        && get(/databases/$(database)/documents/enrollments/$(enrollmentDocId(request.auth.uid, courseId))).data.courseKind == "paid";
    }
    match /qa/{document} {
      allow read: if isSignedIn()
        && resource.data.courseId is string
        && isEnrolledPaid(resource.data.courseId);
      allow write: if false;
    }

    // Active website logo. Readable by everyone (it is displayed on every
    // page). Logo configuration now lives server-side (MySQL `logos` table,
    // managed through the /api/logo routes, which verify the caller is an
    // authorized admin), so the legacy Firestore mirror below is
    // write-disabled entirely — no client can modify it.
    match /logos/{logoId} {
      allow read: if true;
      allow write: if false;
    }

    // Hero banner slider. Readable by everyone (displayed on the homepage);
    // the "active" document is replaced whenever a banner image is uploaded
    // from the website. Images live in Firebase Storage — only their URLs and
    // metadata are stored here. Each slide is validated by index (the rules
    // language used here does not support list lambdas).
    function validSlide(slide) {
      return slide is map
        && slide.id is string
        && slide.url is string
        && slide.url.startsWith("https://firebasestorage.googleapis.com/")
        && slide.fileName is string
        && slide.href is string;
    }
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if bannerId == "active"
        && request.resource.data.slides is list
        && request.resource.data.slides.size() >= 1
        && request.resource.data.slides.size() <= 8
        && (request.resource.data.slides.size() < 1 || validSlide(request.resource.data.slides[0]))
        && (request.resource.data.slides.size() < 2 || validSlide(request.resource.data.slides[1]))
        && (request.resource.data.slides.size() < 3 || validSlide(request.resource.data.slides[2]))
        && (request.resource.data.slides.size() < 4 || validSlide(request.resource.data.slides[3]))
        && (request.resource.data.slides.size() < 5 || validSlide(request.resource.data.slides[4]))
        && (request.resource.data.slides.size() < 6 || validSlide(request.resource.data.slides[5]))
        && (request.resource.data.slides.size() < 7 || validSlide(request.resource.data.slides[6]))
        && (request.resource.data.slides.size() < 8 || validSlide(request.resource.data.slides[7]));
    }
  }
}